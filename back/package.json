{
  "name": "yt-to-mp3-backend",
  "version": "1.0.0",
  "description": "YouTube to MP3 Converter Desktop",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "electron": "electron .",
    "dist": "electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.2.0",
    "yt-dlp-exec": "^3.0.12"
  },
  "devDependencies": {
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.youtube.tomp3",
    "productName": "yt-to-mp3",
    "win": {
      "target": "nsis"
    },
    "files": [
      "**/*",
      "!temp/*"
    ],
    "extraResources": [
      {
        "from": "../front/dist",
        "to": "front/dist"
      }
    ],
    "asarUnpack": [
      "**/node_modules/yt-dlp-exec/**",
      "**/node_modules/ffmpeg-static/**"
    ]
  }
}